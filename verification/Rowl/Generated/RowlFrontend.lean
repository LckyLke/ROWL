                 form := value.form,
                 lexical := value1,
                 datatype := value2
               }, value.remaining))
          | core.result.Result.Err error =>
            ok (core.result.Result.Err
              (functional_literals.SourceLiteralError.Datatype error))
    | core.result.Result.Err error => ok (core.result.Result.Err error)
  | core.result.Result.Err error => ok (core.result.Result.Err error)

