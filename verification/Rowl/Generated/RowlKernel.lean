    Visibility: public -/
def anonymous_graph.connected
  (edges : anonymous_graph.AnonymousEdges) (left : model.AnonymousIndividual)
  (right : model.AnonymousIndividual) :
  Result (Bool × anonymous_graph.AnonymousEdges)
  := do
  let b ← anonymous_graph.same_individual left right
  if b
  then ok (true, edges)
  else
    match edges with
    | anonymous_graph.AnonymousEdges.Empty =>
      ok (false, anonymous_graph.AnonymousEdges.Empty)
    | anonymous_graph.AnonymousEdges.Edge a b1 next =>
      let (direct, next1) ← anonymous_graph.connected next left right
      if direct
      then ok (true, anonymous_graph.AnonymousEdges.Edge a b1 next1)
      else
        let (to_a, next2) ← anonymous_graph.connected next1 left a
        let (from_b, next3) ← anonymous_graph.connected next2 b1 right
        if to_a
        then
          if from_b
          then ok (true, anonymous_graph.AnonymousEdges.Edge a b1 next3)
          else
            let (to_b, next4) ← anonymous_graph.connected next3 left b1
            let (from_a, next5) ← anonymous_graph.connected next4 a right
            let b2 ← if to_b
                       then ok from_a
                       else ok false
            ok (b2, anonymous_graph.AnonymousEdges.Edge a b1 next5)
        else
          let (to_b, next4) ← anonymous_graph.connected next3 left b1
          let (from_a, next5) ← anonymous_graph.connected next4 a right
          let b2 ← if to_b
                     then ok from_a
                     else ok false
