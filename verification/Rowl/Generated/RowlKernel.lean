def shi_ontology.axiom_parts
  («axiom» : model.Axiom) (parts : shi_ontology.Parts) :
  Result (Option shi_ontology.Parts)
  := do
  match «axiom» with
  | model.Axiom.Declaration _ => ok (some parts)
