def functional_literals.read_literal
  (table : prefixes.PrefixTable) (bytes : alloc.vec.Vec Std.U8)
  (tokens : functional_lexer.Tokens) (lexical_limit : Std.Usize)
  (datatype_limit : Std.Usize) :
