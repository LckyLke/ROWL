  let b ← encoding.scalar codepoint
  if b
  then
    if codepoint < 128#u32
    then
      let i ← lift (UScalar.cast .U8 codepoint)
      ok (some (encoding.Encoded.One i))
    else
      if codepoint < 2048#u32
      then
        let i ← codepoint / 64#u32
        let i1 ← 192#u32 + i
        let i2 ← lift (UScalar.cast .U8 i1)
        let i3 ← codepoint % 64#u32
        let i4 ← 128#u32 + i3
        let i5 ← lift (UScalar.cast .U8 i4)
        ok (some (encoding.Encoded.Two i2 i5))
      else
        if codepoint < 65536#u32
        then
          let i ← codepoint / 4096#u32
          let i1 ← 224#u32 + i
          let i2 ← lift (UScalar.cast .U8 i1)
          let i3 ← codepoint / 64#u32
          let i4 ← i3 % 64#u32
          let i5 ← 128#u32 + i4
          let i6 ← lift (UScalar.cast .U8 i5)
          let i7 ← codepoint % 64#u32
          let i8 ← 128#u32 + i7
          let i9 ← lift (UScalar.cast .U8 i8)
          ok (some (encoding.Encoded.Three i2 i6 i9))
        else
          let i ← codepoint / 262144#u32
          let i1 ← 240#u32 + i
          let i2 ← lift (UScalar.cast .U8 i1)
          let i3 ← codepoint / 4096#u32
          let i4 ← i3 % 64#u32
          let i5 ← 128#u32 + i4
          let i6 ← lift (UScalar.cast .U8 i5)
          let i7 ← codepoint / 64#u32
          let i8 ← i7 % 64#u32
          let i9 ← 128#u32 + i8
          let i10 ← lift (UScalar.cast .U8 i9)
          let i11 ← codepoint % 64#u32
          let i12 ← 128#u32 + i11
          let i13 ← lift (UScalar.cast .U8 i12)
          ok (some (encoding.Encoded.Four i2 i6 i10 i13))
  else ok none

