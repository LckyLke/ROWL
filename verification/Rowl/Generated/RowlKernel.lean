def axiom_set.build_from
  (source : alloc.vec.Vec axiom_set.AxiomOccurrence) (index : Std.Usize)
  (representative_of : alloc.vec.Vec Std.Usize)
  (representatives : alloc.vec.Vec Std.Usize) :
  Result axiom_set.AxiomSet
  := do
  let i := alloc.vec.Vec.len source
  if index < i
  then
    let ao ←
      alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice
        axiom_set.AxiomOccurrence) source index
    let representative ←
      axiom_set.first_match_from source ao.axiom index 0#usize
    let representative_of1 ←
      alloc.vec.Vec.push representative_of representative
    let representatives1 ←
      if representative = index
      then alloc.vec.Vec.push representatives index
      else ok representatives
    let i1 ← index + 1#usize
    axiom_set.build_from source i1 representative_of1 representatives1
  else ok { source, representative_of, representatives }
partial_fixpoint

/-- [rowl_kernel::axiom_set::build]:
