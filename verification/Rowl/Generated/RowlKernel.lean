def range_equality.same_range
  (left : model.DataRange) (right : model.DataRange) : Result Bool := do
  match left with
  | model.DataRange.Datatype a =>
    match right with
    | model.DataRange.Datatype b =>
      symbols.same_spelling a.iri.spelling b.iri.spelling
    | model.DataRange.Intersection _ => ok false
    | model.DataRange.Union _ => ok false
    | model.DataRange.Complement _ => ok false
    | model.DataRange.OneOf _ => ok false
    | model.DataRange.Restriction _ _ => ok false
  | model.DataRange.Intersection a =>
    match right with
    | model.DataRange.Datatype _ => ok false
    | model.DataRange.Intersection b => range_equality.same_range_set a b
    | model.DataRange.Union _ => ok false
    | model.DataRange.Complement _ => ok false
    | model.DataRange.OneOf _ => ok false
    | model.DataRange.Restriction _ _ => ok false
  | model.DataRange.Union a =>
    match right with
    | model.DataRange.Datatype _ => ok false
    | model.DataRange.Intersection _ => ok false
    | model.DataRange.Union b => range_equality.same_range_set a b
    | model.DataRange.Complement _ => ok false
    | model.DataRange.OneOf _ => ok false
    | model.DataRange.Restriction _ _ => ok false
  | model.DataRange.Complement a =>
    match right with
    | model.DataRange.Datatype _ => ok false
    | model.DataRange.Intersection _ => ok false
    | model.DataRange.Union _ => ok false
    | model.DataRange.Complement b => range_equality.same_range a b
    | model.DataRange.OneOf _ => ok false
    | model.DataRange.Restriction _ _ => ok false
  | model.DataRange.OneOf a =>
    match right with
    | model.DataRange.Datatype _ => ok false
    | model.DataRange.Intersection _ => ok false
    | model.DataRange.Union _ => ok false
    | model.DataRange.Complement _ => ok false
    | model.DataRange.OneOf b => range_equality.same_literal_set a b
    | model.DataRange.Restriction _ _ => ok false
  | model.DataRange.Restriction a xs =>
    match right with
    | model.DataRange.Datatype _ => ok false
    | model.DataRange.Intersection _ => ok false
    | model.DataRange.Union _ => ok false
    | model.DataRange.Complement _ => ok false
    | model.DataRange.OneOf _ => ok false
    | model.DataRange.Restriction b ys =>
      let b1 ← symbols.same_spelling a.iri.spelling b.iri.spelling
      if b1
      then range_equality.same_facet_set xs ys
      else ok false
partial_fixpoint

end

