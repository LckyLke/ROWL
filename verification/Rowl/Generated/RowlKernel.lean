        ok (some { parts with definitions := v })
      else ok none
  else
    let o ← concepts.translate sub false
    match o with
    | none => ok none
    | some outside =>
      ok (some
        {
          parts
            with
            axioms :=
              (concepts.Concept.And
                parts.axioms
                (concepts.Concept.Or
                outside
                sup))
        })

