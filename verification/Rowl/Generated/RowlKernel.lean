            (functional_document.DocumentError.Expected
            functional_document.DocumentExpected.Close i))
        | functional_lexer.Tokens.Cons _ next =>
          match next with
          | functional_lexer.Tokens.Empty =>
            ok (core.result.Result.Ok
              {
