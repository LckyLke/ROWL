    | functional.Terminal.Comment => ok false
  | functional_assertions.AssertionExpected.Close =>
    match terminal with
    | functional.Terminal.Keyword _ => ok false
    | functional.Terminal.Open => ok false
    | functional.Terminal.Close => ok true
