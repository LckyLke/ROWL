          (alloc.vec.Vec.new functional_document.SourceAxiom) limits
      match r2 with
      | core.result.Result.Ok value2 =>
        let (axioms, tokens1) := value2
        match tokens1 with
        | functional_lexer.Tokens.Empty =>
