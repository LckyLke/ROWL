    Source: 'crates/rowl-kernel/src/axiom_set.rs', lines 30:0-40:1 -/
def axiom_set.first_forbidden_from
  (source : alloc.vec.Vec axiom_set.AxiomOccurrence) (index : Std.Usize) :
  Result (Option axiom_set.AxiomOccurrence)
  := do
  let i := alloc.vec.Vec.len source
  if index < i
  then
    let ao ←
      alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice
        axiom_set.AxiomOccurrence) source index
    let b ← arity.axiom_allowed ao.axiom
    if b
    then let i1 ← index + 1#usize
         axiom_set.first_forbidden_from source i1
    else ok (some ao)
  else ok none
partial_fixpoint

/-- [rowl_kernel::axiom_set::first_match_from]:
