  (entities : collection.CollectedEntities) (limit : Std.U32) :
  Result indexing.IndexResult
  := do
  let st ← symbols.empty limit
  let (declarations, st1) ← indexing.index_uses entities.declarations st
  match declarations with
  | indexing.Indexed.Complete declarations1 =>
    let (uses, st2) ← indexing.index_uses entities.uses st1
    match uses with
    | indexing.Indexed.Complete uses1 =>
      ok (indexing.IndexResult.Complete st2 declarations1 uses1)
    | indexing.Indexed.CapacityExceeded iri =>
      ok (indexing.IndexResult.CapacityExceeded st2 iri)
  | indexing.Indexed.CapacityExceeded iri =>
    ok (indexing.IndexResult.CapacityExceeded st1 iri)

