    Source: 'crates/rowl-kernel/src/anonymous_restrictions.rs', lines 29:0-45:1
    Visibility: public -/
def anonymous_restrictions.check_anonymous
  (axioms : alloc.vec.Vec model.AnnotatedAxiom) :
  Result anonymous_restrictions.AnonymousCheck
  := do
  let o ← anonymous.check_positions axioms
  match o with
  | none =>
    let fc ← anonymous_graph.check_forest axioms
    match fc with
    | anonymous_graph.ForestCheck.Forest =>
      let mc ← anonymous_multiplicity.check_multiplicity axioms
      match mc with
      | anonymous_multiplicity.MultiplicityCheck.Allowed =>
        let bc ← anonymous_boundary.check_boundary axioms
        match bc with
        | anonymous_boundary.BoundaryCheck.Allowed =>
          ok anonymous_restrictions.AnonymousCheck.Allowed
        | anonymous_boundary.BoundaryCheck.NoRoot vertex =>
          ok (anonymous_restrictions.AnonymousCheck.NoBoundaryRoot vertex)
      | anonymous_multiplicity.MultiplicityCheck.MultipleAssertions first
        second =>
        ok (anonymous_restrictions.AnonymousCheck.MultipleAssertions first
          second)
    | anonymous_graph.ForestCheck.SelfLoop vertex =>
      ok (anonymous_restrictions.AnonymousCheck.SelfLoop vertex)
    | anonymous_graph.ForestCheck.Cycle left right =>
      ok (anonymous_restrictions.AnonymousCheck.Cycle left right)
  | some item =>
    ok (anonymous_restrictions.AnonymousCheck.ForbiddenPosition item)

