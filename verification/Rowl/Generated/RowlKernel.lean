      | datatype_definitions.DefinitionCheck.PredefinedRedefined _ => ok dc
      | datatype_definitions.DefinitionCheck.MultipleDefinitions _ _ => ok dc
    | typing.EntityKind.ObjectProperty =>
      datatype_definitions.check_uses axioms next
    | typing.EntityKind.DataProperty =>
      datatype_definitions.check_uses axioms next
    | typing.EntityKind.AnnotationProperty =>
      datatype_definitions.check_uses axioms next
    | typing.EntityKind.NamedIndividual =>
      datatype_definitions.check_uses axioms next
