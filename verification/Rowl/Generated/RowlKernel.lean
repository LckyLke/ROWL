  := do
  let pr ← functional.longest terminal bytes position
  match pr with
  | longest.PrefixResult.Matched o =>
    match o with
    | none => ok functional.Selection.NoMatch
    | some «end» =>
      ok (functional.Selection.Token { terminal, start := position, «end» })
