  (table : prefixes.PrefixTable) (bytes : alloc.vec.Vec Std.U8)
  (tokens : functional_lexer.Tokens)
  (axioms : alloc.vec.Vec functional_document.SourceAxiom)
  (limits : functional_document.DocumentLimits) :
