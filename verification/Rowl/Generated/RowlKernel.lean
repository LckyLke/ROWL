  model.AnnotatedAxiom →
  datatype_restrictions.StructuralDatatypeCheck
| MultipleDefinitions :
  model.AnnotatedAxiom →
  model.AnnotatedAxiom →
  datatype_restrictions.StructuralDatatypeCheck
