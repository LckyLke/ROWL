  := do
  let o ← alc_ontology.internalize items
  match o with
  | none => ok none
  | some axioms =>
    let o1 ← nnf.nnf sub true
    match o1 with
    | none => ok none
    | some inside =>
      let o2 ← nnf.nnf sup false
      match o2 with
      | none => ok none
