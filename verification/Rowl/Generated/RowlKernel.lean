/-- [rowl_kernel::axiom_equality::same_axiom]:
    Source: 'crates/rowl-kernel/src/axiom_equality.rs', lines 361:0-364:1
    Visibility: public -/
def axiom_equality.same_axiom
  (left : model.AnnotatedAxiom) (right : model.AnnotatedAxiom) :
  Result Bool
  := do
  let b ← axiom_equality.same_body left.axiom right.axiom
  if b
  then
    assertion_equality.same_annotation_set left.annotations right.annotations
  else ok false

