          next1), st1)
      | indexing.Indexed.CapacityExceeded _ => ok (tail, st1)
    | symbols.InternResult.Inserted symbol =>
      let (tail, st1) ← indexing.index_uses next st
      match tail with
      | indexing.Indexed.Complete next1 =>
        ok (indexing.Indexed.Complete (typing.Occurrences.Entry symbol kind
          next1), st1)
