def datatype_definitions.check_uses
  (axioms : alloc.vec.Vec model.AnnotatedAxiom) (uses : collection.EntityUses)
  :
  Result datatype_definitions.DefinitionCheck
  := do
  match uses with
  | collection.EntityUses.Empty =>
    ok datatype_definitions.DefinitionCheck.Allowed
  | collection.EntityUses.Entry iri ek next =>
    match ek with
    | typing.EntityKind.Class => datatype_definitions.check_uses axioms next
    | typing.EntityKind.Datatype =>
      let dc ← datatype_definitions.check_one axioms iri
      match dc with
      | datatype_definitions.DefinitionCheck.Allowed =>
        datatype_definitions.check_uses axioms next
      | datatype_definitions.DefinitionCheck.MissingDefinition _ => ok dc
      | datatype_definitions.DefinitionCheck.PredefinedRedefined _ => ok dc
      | datatype_definitions.DefinitionCheck.MultipleDefinitions _ _ => ok dc
    | typing.EntityKind.ObjectProperty =>
      datatype_definitions.check_uses axioms next
    | typing.EntityKind.DataProperty =>
      datatype_definitions.check_uses axioms next
    | typing.EntityKind.AnnotationProperty =>
      datatype_definitions.check_uses axioms next
    | typing.EntityKind.NamedIndividual =>
      datatype_definitions.check_uses axioms next
partial_fixpoint

