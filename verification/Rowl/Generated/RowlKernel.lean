def indexing.index_uses
  (source : collection.EntityUses) (table : symbols.SymbolTable) :
  Result (indexing.Indexed × symbols.SymbolTable)
  := do
  match source with
  | collection.EntityUses.Empty =>
    ok (indexing.Indexed.Complete typing.Occurrences.Empty, table)
  | collection.EntityUses.Entry iri kind next =>
    let (outcome, st) ← symbols.intern table iri.spelling
    match outcome with
    | symbols.InternResult.Existing symbol =>
      let (tail, st1) ← indexing.index_uses next st
      match tail with
      | indexing.Indexed.Complete next1 =>
        ok (indexing.Indexed.Complete (typing.Occurrences.Entry symbol kind
          next1), st1)
      | indexing.Indexed.CapacityExceeded _ => ok (tail, st1)
    | symbols.InternResult.Inserted symbol =>
      let (tail, st1) ← indexing.index_uses next st
      match tail with
      | indexing.Indexed.Complete next1 =>
        ok (indexing.Indexed.Complete (typing.Occurrences.Entry symbol kind
          next1), st1)
      | indexing.Indexed.CapacityExceeded _ => ok (tail, st1)
    | symbols.InternResult.CapacityExceeded =>
      ok (indexing.Indexed.CapacityExceeded iri, st)
