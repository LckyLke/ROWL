def datatype_order.reachable
  (edges : datatype_order.Dependencies) (left : model.Iri) (right : model.Iri)
  :
  Result (Bool × datatype_order.Dependencies)
  := do
  let b ← symbols.same_spelling left.spelling right.spelling
  if b
  then ok (true, edges)
  else
    match edges with
    | datatype_order.Dependencies.Empty =>
      ok (false, datatype_order.Dependencies.Empty)
    | datatype_order.Dependencies.Edge a b1 next =>
      let (direct, next1) ← datatype_order.reachable next left right
      if direct
      then ok (true, datatype_order.Dependencies.Edge a b1 next1)
      else
        let (to_a, next2) ← datatype_order.reachable next1 left a
        let (from_b, next3) ← datatype_order.reachable next2 b1 right
        let b2 ← if to_a
                   then ok from_b
                   else ok false
        ok (b2, datatype_order.Dependencies.Edge a b1 next3)
partial_fixpoint

