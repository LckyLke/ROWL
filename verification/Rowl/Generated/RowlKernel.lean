def functional.name_start (codepoint : Std.U32) : Result Bool := do
  if codepoint = 58#u32
  then ok true
  else
    if 65#u32 <= codepoint
    then
      if codepoint <= 90#u32
      then ok true
      else
        if 97#u32 <= codepoint
        then
          if codepoint <= 122#u32
          then ok true
          else ok (128#u32 <= codepoint)
        else ok (128#u32 <= codepoint)
    else
      if 97#u32 <= codepoint
      then if codepoint <= 122#u32
           then ok true
           else ok (128#u32 <= codepoint)
      else ok (128#u32 <= codepoint)

