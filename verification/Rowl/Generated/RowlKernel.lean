  (table : prefixes.PrefixTable) (bytes : alloc.vec.Vec Std.U8)
  (tokens : functional_lexer.Tokens) (limits : functional_classes.ClassLimits)
  :
  Result (core.result.Result ((alloc.vec.Vec
