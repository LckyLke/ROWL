  let i := alloc.vec.Vec.len items
  if index < i
  then
    let aa ←
      alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice
        model.AnnotatedAxiom) items index
    let rf ← roles.axiom_facts aa
