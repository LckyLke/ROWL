def datatype_order.check_dependencies
  (edges : datatype_order.Dependencies) :
  Result datatype_order.DependencyCheck
  := do
  match edges with
  | datatype_order.Dependencies.Empty =>
    ok datatype_order.DependencyCheck.Acyclic
  | datatype_order.Dependencies.Edge smaller larger next =>
    let (reverse, next1) ← datatype_order.reachable next larger smaller
    if reverse
    then ok (datatype_order.DependencyCheck.Cycle smaller larger)
    else datatype_order.check_dependencies next1
partial_fixpoint

