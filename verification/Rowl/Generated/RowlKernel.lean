    | model.DataRange.OneOf _ => ok false
    | model.DataRange.Restriction _ _ => ok false
  | model.DataRange.Intersection a =>
    match right with
    | model.DataRange.Datatype _ => ok false
    | model.DataRange.Intersection b => range_equality.same_range_set a b
    | model.DataRange.Union _ => ok false
    | model.DataRange.Complement _ => ok false
    | model.DataRange.OneOf _ => ok false
    | model.DataRange.Restriction _ _ => ok false
