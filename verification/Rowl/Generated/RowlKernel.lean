    if 0#usize < i
    then ok 0#u8
    else ok 1#u8
  | model.Axiom.DataPropertyDomain _ _ => ok 1#u8
  | model.Axiom.DataPropertyRange _ _ => ok 1#u8
  | model.Axiom.FunctionalDataProperty _ => ok 1#u8
  | model.Axiom.DatatypeDefinition _ _ => ok 1#u8
