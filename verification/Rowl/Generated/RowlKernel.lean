def axiom_set.first_match_from
  (source : alloc.vec.Vec axiom_set.AxiomOccurrence)
  (sought : model.AnnotatedAxiom) («end» : Std.Usize) (index : Std.Usize) :
  Result Std.Usize
  := do
  if index < «end»
  then
    let ao ←
      alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice
        axiom_set.AxiomOccurrence) source index
    let b ← axiom_equality.same_axiom ao.axiom sought
    if b
    then ok index
    else
      let i ← index + 1#usize
      axiom_set.first_match_from source sought «end» i
  else ok «end»
