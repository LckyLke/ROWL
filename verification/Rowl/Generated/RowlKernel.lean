/-- [rowl_kernel::functional_lexer::delimiter]:
    Source: 'crates/rowl-kernel/src/functional_lexer.rs', lines 26:0-28:1 -/
def functional_lexer.delimiter (cp : Std.U32) : Result Bool := do
  if cp = 61#u32
  then ok true
  else
    if cp = 40#u32
    then ok true
    else
      if cp = 41#u32
      then ok true
      else
        if cp = 60#u32
        then ok true
        else
          if cp = 62#u32
          then ok true
          else if cp = 64#u32
               then ok true
               else ok (cp = 94#u32)

