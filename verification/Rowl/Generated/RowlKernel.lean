    | datatypes.DataValue.Tagged _ _ => ok false
    | datatypes.DataValue.Truth _ => ok false
  | datatypes.DataValue.Text a =>
    match right with
    | datatypes.DataValue.Number _ _ _ => ok false
    | datatypes.DataValue.Text b => datatypes.same_bytes a b
