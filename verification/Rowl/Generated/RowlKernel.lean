def datatype_restrictions.check_structural_datatypes
  (ontology : model.RawOntology) :
  Result datatype_restrictions.StructuralDatatypeCheck
  := do
  let ddc ← datatype_restrictions.check_definition_rules ontology
  match ddc with
  | datatype_restrictions.DatatypeDefinitionCheck.Allowed =>
    let pc ← datatype_positions.check_ontology_positions ontology
    match pc with
    | datatype_positions.PositionCheck.Allowed =>
      ok datatype_restrictions.StructuralDatatypeCheck.Allowed
    | datatype_positions.PositionCheck.OntologyAnnotation item =>
      ok
        (datatype_restrictions.StructuralDatatypeCheck.ForbiddenOntologyAnnotation
        item)
    | datatype_positions.PositionCheck.Axiom item =>
      ok (datatype_restrictions.StructuralDatatypeCheck.ForbiddenAxiomPosition
        item)
  | datatype_restrictions.DatatypeDefinitionCheck.MissingDefinition iri =>
    ok (datatype_restrictions.StructuralDatatypeCheck.MissingDefinition iri)
  | datatype_restrictions.DatatypeDefinitionCheck.PredefinedRedefined item =>
    ok (datatype_restrictions.StructuralDatatypeCheck.PredefinedRedefined item)
  | datatype_restrictions.DatatypeDefinitionCheck.MultipleDefinitions first
    second =>
    ok (datatype_restrictions.StructuralDatatypeCheck.MultipleDefinitions first
      second)
  | datatype_restrictions.DatatypeDefinitionCheck.Cycle smaller larger =>
    ok (datatype_restrictions.StructuralDatatypeCheck.Cycle smaller larger)

