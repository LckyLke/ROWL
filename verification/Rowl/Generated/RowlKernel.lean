  | tbox.Items.Concept concept next =>
    match concept with
    | nnf.NnfConcept.Top =>
      tbox.existentials_hold all next history axioms roles
    | nnf.NnfConcept.Bottom =>
      tbox.existentials_hold all next history axioms roles
    | nnf.NnfConcept.Atom _ =>
      tbox.existentials_hold all next history axioms roles
    | nnf.NnfConcept.NotAtom _ =>
      tbox.existentials_hold all next history axioms roles
    | nnf.NnfConcept.And _ _ =>
      tbox.existentials_hold all next history axioms roles
    | nnf.NnfConcept.Or _ _ =>
