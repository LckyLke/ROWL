/-- [rowl_kernel::datatype_positions::body_allowed]:
    Source: 'crates/rowl-kernel/src/datatype_positions.rs', lines 146:0-189:1
    Visibility: public -/
def datatype_positions.body_allowed
  (axioms : alloc.vec.Vec model.AnnotatedAxiom) (body : model.Axiom) :
  Result Bool
  := do
  match body with
  | model.Axiom.Declaration _ => ok true
  | model.Axiom.SubClassOf a b =>
    let b1 ← datatype_positions.class_allowed axioms a
    if b1
    then datatype_positions.class_allowed axioms b
    else ok false
  | model.Axiom.EquivalentClasses xs =>
    let b ← datatype_positions.class_allowed axioms xs.first
    if b
    then
      let b1 ← datatype_positions.class_allowed axioms xs.second
      if b1
      then datatype_positions.classes_from axioms xs.rest 0#usize
      else ok false
    else ok false
  | model.Axiom.DisjointClasses xs =>
    let b ← datatype_positions.class_allowed axioms xs.first
    if b
    then
      let b1 ← datatype_positions.class_allowed axioms xs.second
      if b1
      then datatype_positions.classes_from axioms xs.rest 0#usize
      else ok false
    else ok false
  | model.Axiom.DisjointUnion _ xs =>
    let b ← datatype_positions.class_allowed axioms xs.first
    if b
    then
      let b1 ← datatype_positions.class_allowed axioms xs.second
      if b1
      then datatype_positions.classes_from axioms xs.rest 0#usize
      else ok false
    else ok false
  | model.Axiom.SubObjectPropertyOf _ _ => ok true
  | model.Axiom.EquivalentObjectProperties _ => ok true
  | model.Axiom.DisjointObjectProperties _ => ok true
  | model.Axiom.InverseObjectProperties _ _ => ok true
  | model.Axiom.ObjectPropertyDomain _ e =>
    datatype_positions.class_allowed axioms e
  | model.Axiom.ObjectPropertyRange _ e =>
    datatype_positions.class_allowed axioms e
  | model.Axiom.FunctionalObjectProperty _ => ok true
  | model.Axiom.InverseFunctionalObjectProperty _ => ok true
  | model.Axiom.ReflexiveObjectProperty _ => ok true
  | model.Axiom.IrreflexiveObjectProperty _ => ok true
  | model.Axiom.SymmetricObjectProperty _ => ok true
  | model.Axiom.AsymmetricObjectProperty _ => ok true
  | model.Axiom.TransitiveObjectProperty _ => ok true
  | model.Axiom.SubDataPropertyOf _ _ => ok true
  | model.Axiom.EquivalentDataProperties _ => ok true
  | model.Axiom.DisjointDataProperties _ => ok true
  | model.Axiom.DataPropertyDomain _ e =>
    datatype_positions.class_allowed axioms e
  | model.Axiom.DataPropertyRange _ range =>
    datatype_positions.range_allowed axioms range
  | model.Axiom.FunctionalDataProperty _ => ok true
  | model.Axiom.DatatypeDefinition _ range =>
    datatype_positions.range_allowed axioms range
  | model.Axiom.HasKey e _ _ => datatype_positions.class_allowed axioms e
  | model.Axiom.SameIndividual _ => ok true
  | model.Axiom.DifferentIndividuals _ => ok true
  | model.Axiom.ClassAssertion e _ => datatype_positions.class_allowed axioms e
  | model.Axiom.ObjectPropertyAssertion _ _ _ => ok true
  | model.Axiom.NegativeObjectPropertyAssertion _ _ _ => ok true
  | model.Axiom.DataPropertyAssertion _ _ literal =>
    datatype_positions.literal_allowed axioms literal
  | model.Axiom.NegativeDataPropertyAssertion _ _ literal =>
    datatype_positions.literal_allowed axioms literal
  | model.Axiom.AnnotationAssertion _ _ value =>
    datatype_positions.value_allowed axioms value
  | model.Axiom.SubAnnotationPropertyOf _ _ => ok true
  | model.Axiom.AnnotationPropertyDomain _ _ => ok true
  | model.Axiom.AnnotationPropertyRange _ _ => ok true

