  (tokens : functional_lexer.Tokens) (limit : Std.Usize) :
  Result (core.result.Result (functional_header.HeaderIri ×
    functional_lexer.Tokens) functional_data_axioms.DataAxiomError)
  := do
  match tokens with
  | functional_lexer.Tokens.Empty =>
