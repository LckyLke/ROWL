  | model.Axiom.DisjointUnion _ values =>
    let r ← roles.class_requirements values.first
    let r1 ← roles.class_requirements values.second
    let r2 ← roles.classes_from values.rest 0#usize
    let r3 ← roles.roles_append r1 r2
