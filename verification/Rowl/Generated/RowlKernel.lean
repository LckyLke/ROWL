def datatype_definitions.check_one
  (axioms : alloc.vec.Vec model.AnnotatedAxiom) (datatype : model.Iri) :
  Result datatype_definitions.DefinitionCheck
  := do
  let built_in ← datatype_definitions.predefined datatype
  let o ← datatype_definitions.first_from axioms datatype 0#usize
  match o with
  | none =>
    if built_in
    then ok datatype_definitions.DefinitionCheck.Allowed
    else ok (datatype_definitions.DefinitionCheck.MissingDefinition datatype)
  | some first =>
    if built_in
    then ok (datatype_definitions.DefinitionCheck.PredefinedRedefined first)
    else
      let o1 ←
        datatype_definitions.distinct_from axioms datatype first 0#usize
      match o1 with
      | none => ok datatype_definitions.DefinitionCheck.Allowed
      | some second =>
        ok (datatype_definitions.DefinitionCheck.MultipleDefinitions first
          second)

