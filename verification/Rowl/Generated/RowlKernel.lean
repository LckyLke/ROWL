def datatype_restrictions.check_definition_rules
  (ontology : model.RawOntology) :
  Result datatype_restrictions.DatatypeDefinitionCheck
  := do
  let dc ← datatype_definitions.check_definitions ontology
  match dc with
  | datatype_definitions.DefinitionCheck.Allowed =>
    let dc1 ← datatype_order.check_acyclic ontology.axioms
    match dc1 with
    | datatype_order.DependencyCheck.Acyclic =>
      ok datatype_restrictions.DatatypeDefinitionCheck.Allowed
    | datatype_order.DependencyCheck.Cycle smaller larger =>
      ok (datatype_restrictions.DatatypeDefinitionCheck.Cycle smaller larger)
  | datatype_definitions.DefinitionCheck.MissingDefinition iri =>
    ok (datatype_restrictions.DatatypeDefinitionCheck.MissingDefinition iri)
  | datatype_definitions.DefinitionCheck.PredefinedRedefined item =>
    ok (datatype_restrictions.DatatypeDefinitionCheck.PredefinedRedefined item)
  | datatype_definitions.DefinitionCheck.MultipleDefinitions first second =>
    ok (datatype_restrictions.DatatypeDefinitionCheck.MultipleDefinitions first
      second)

