def axiom_set.build
  (source : alloc.vec.Vec axiom_set.AxiomOccurrence) :
  Result axiom_set.BuildResult
  := do
  let o ← axiom_set.first_forbidden_from source 0#usize
  match o with
  | none =>
    let «as» ←
      axiom_set.build_from source 0#usize (alloc.vec.Vec.new Std.Usize)
        (alloc.vec.Vec.new Std.Usize)
    ok (axiom_set.BuildResult.Set «as»)
  | some item => ok (axiom_set.BuildResult.InvalidArity item)

