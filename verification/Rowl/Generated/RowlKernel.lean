def datatype_positions.range_allowed
  (axioms : alloc.vec.Vec model.AnnotatedAxiom) (range : model.DataRange) :
  Result Bool
  := do
  match range with
  | model.DataRange.Datatype _ => ok true
  | model.DataRange.Intersection xs =>
    let b ← datatype_positions.range_allowed axioms xs.first
    if b
    then
      let b1 ← datatype_positions.range_allowed axioms xs.second
      if b1
      then datatype_positions.ranges_from axioms xs.rest 0#usize
      else ok false
    else ok false
  | model.DataRange.Union xs =>
    let b ← datatype_positions.range_allowed axioms xs.first
    if b
    then
      let b1 ← datatype_positions.range_allowed axioms xs.second
      if b1
      then datatype_positions.ranges_from axioms xs.rest 0#usize
      else ok false
    else ok false
  | model.DataRange.Complement inner =>
    datatype_positions.range_allowed axioms inner
  | model.DataRange.OneOf xs =>
    let b ← datatype_positions.literal_allowed axioms xs.first
    if b
    then datatype_positions.literals_from axioms xs.rest 0#usize
    else ok false
  | model.DataRange.Restriction datatype xs =>
    let b ← datatype_positions.defined_datatype axioms datatype.iri
    if b
    then ok false
    else
