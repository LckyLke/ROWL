Prefix(ex:=<https://example.org/maintenance/>)
Ontology(ex:plant
 Annotation(rdfs:label "Maintenance classes")
 Declaration(Class(ex:Machine))
 Declaration(Class(ex:Pump))
 Declaration(Class(ex:Part))
 Declaration(ObjectProperty(ex:hasPart))
 SubClassOf(ex:Pump ex:Machine)
 SubClassOf(Annotation(rdfs:comment "Every machine has a part") ex:Machine ObjectSomeValuesFrom(ex:hasPart ex:Part))
 ObjectPropertyRange(ex:hasPart ex:Part)
 ObjectPropertyDomain(ex:hasPart ObjectUnionOf(ex:Machine ex:Part))
 DisjointClasses(ex:Machine ex:Part)
 DisjointUnion(ex:Part ex:Motor ex:Valve ex:Seal)
 EquivalentClasses(ex:NeedsInspection ObjectSomeValuesFrom(ex:hasPart ex:FaultyPart))
 SubClassOf(ex:NeedsInspection ObjectComplementOf(ex:InService)))
