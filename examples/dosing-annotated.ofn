Prefix(ex:=<https://example.org/dosing/>)
Ontology(ex:orders ex:orders-1
 Import(<https://example.org/drugs>)
 Annotation(rdfs:label "dosing orders"@en)
 Annotation(rdfs:comment "the dosing example with annotations"^^xsd:string)
 Declaration(Annotation(rdfs:comment "drugs of the formulary"@en) Class(ex:Drug))
 Declaration(Class(ex:Opioid))
 Declaration(Class(ex:Analgesic))
 Declaration(Class(ex:Allergen))
 Declaration(Class(ex:Patient))
 Declaration(Class(ex:Child))
 Declaration(Class(ex:Adult))
 Declaration(Class(ex:Order))
 Declaration(Class(ex:SafeOrder))
 Declaration(ObjectProperty(ex:prescribes))
 Declaration(ObjectProperty(ex:prescribedBy))
 Declaration(ObjectProperty(ex:contains))
 Declaration(ObjectProperty(ex:interactsWith))
 Declaration(DataProperty(ex:doseMg))
 Declaration(DataProperty(ex:ageYears))
 Declaration(DataProperty(ex:weightKg))
 Declaration(AnnotationProperty(ex:source))
 Declaration(Datatype(ex:Dose))
 Declaration(NamedIndividual(ex:morphine))
 Declaration(NamedIndividual(ex:morphineSulfate))
 Declaration(NamedIndividual(ex:ibuprofen))
 Declaration(NamedIndividual(ex:alice))
 Declaration(NamedIndividual(ex:drSmith))
 SubClassOf(Annotation(rdfs:comment "opioids contain an allergen"@en) Annotation(ex:source ex:ward3) ex:Opioid ObjectIntersectionOf(ex:Drug ObjectSomeValuesFrom(ex:contains ex:Allergen)))
 SubClassOf(Annotation(rdfs:label "patients by age"@en) ObjectUnionOf(ex:Child ex:Adult) ex:Patient)
 EquivalentClasses(Annotation(rdfs:comment "adults are not children"^^xsd:string) ex:Adult ObjectComplementOf(ex:Child))
 DisjointClasses(Annotation(rdfs:comment "pairwise"@en) ex:Drug ex:Patient)
 DisjointClasses(Annotation(rdfs:comment "three disjoint classes"@en) Annotation(rdfs:seeAlso ex:Order) ex:Drug ex:Patient ex:Order)
 DisjointUnion(Annotation(ex:source _:order1) ex:Patient ex:Child ex:Adult)
 SubClassOf(ex:Order ObjectAllValuesFrom(ObjectInverseOf(ex:prescribedBy) ex:Patient))
 SubClassOf(ex:Opioid ObjectHasValue(ex:interactsWith ex:ibuprofen))
 SubClassOf(ex:Drug ObjectHasSelf(ex:interactsWith))
 SubClassOf(ex:Order ObjectMinCardinality(1 ex:prescribes))
 SubClassOf(ex:Order ObjectMaxCardinality(3 ex:prescribes ex:Drug))
 SubClassOf(ex:Order ObjectExactCardinality(1 ex:prescribedBy))
 SubClassOf(ex:Analgesic ObjectOneOf(ex:morphine ex:ibuprofen))
 SubClassOf(ex:Patient DataSomeValuesFrom(ex:ageYears xsd:integer))
 SubClassOf(ex:Order DataAllValuesFrom(ex:doseMg DataIntersectionOf(xsd:decimal DataComplementOf(xsd:string))))
 SubClassOf(ex:SafeOrder DataHasValue(ex:doseMg "5"^^xsd:integer))
 SubClassOf(ex:Patient DataMinCardinality(1 ex:weightKg))
 SubClassOf(ex:Order DataExactCardinality(1 ex:doseMg DataOneOf("5"^^xsd:integer "10"^^xsd:integer)))
 SubClassOf(ex:Child DataMaxCardinality(1 ex:ageYears DatatypeRestriction(xsd:integer xsd:minInclusive "0"^^xsd:integer xsd:maxExclusive "18"^^xsd:integer)))
 SubObjectPropertyOf(ex:prescribes ex:interactsWith)
 SubObjectPropertyOf(ObjectPropertyChain(ex:prescribes ObjectInverseOf(ex:prescribedBy)) ex:interactsWith)
 EquivalentObjectProperties(Annotation(rdfs:comment "equivalent properties"@en) ex:contains ex:interactsWith)
 DisjointObjectProperties(ex:prescribes ex:contains)
 DisjointObjectProperties(Annotation(rdfs:comment "three disjoint properties"@en) ex:prescribes ex:contains ex:prescribedBy)
 InverseObjectProperties(Annotation(rdfs:comment "inverses"@en) ex:prescribes ObjectInverseOf(ex:prescribedBy))
 ObjectPropertyDomain(ex:prescribes ex:Order)
 ObjectPropertyRange(ObjectInverseOf(ex:prescribedBy) ex:Patient)
 FunctionalObjectProperty(ex:prescribedBy)
 InverseFunctionalObjectProperty(ObjectInverseOf(ex:contains))
 ReflexiveObjectProperty(ex:interactsWith)
 IrreflexiveObjectProperty(ex:prescribes)
 SymmetricObjectProperty(ex:interactsWith)
 AsymmetricObjectProperty(ex:prescribedBy)
 TransitiveObjectProperty(ex:contains)
 SubDataPropertyOf(ex:weightKg ex:doseMg)
 EquivalentDataProperties(ex:doseMg ex:weightKg)
 DisjointDataProperties(ex:ageYears ex:weightKg)
 DisjointDataProperties(Annotation(rdfs:comment "three disjoint data properties"@en) ex:ageYears ex:weightKg ex:doseMg)
 DataPropertyDomain(ex:doseMg ex:Order)
 DataPropertyRange(ex:ageYears xsd:integer)
 FunctionalDataProperty(ex:ageYears)
 DatatypeDefinition(Annotation(rdfs:comment "a positive dose"@en) ex:Dose DatatypeRestriction(xsd:decimal xsd:minExclusive "0"^^xsd:decimal))
 HasKey(Annotation(rdfs:comment "orders by prescription and dose"@en) ex:Order (ex:prescribes ObjectInverseOf(ex:prescribedBy)) (ex:doseMg))
 SameIndividual(ex:morphine ex:morphineSulfate)
 DifferentIndividuals(ex:morphine ex:ibuprofen)
 DifferentIndividuals(Annotation(rdfs:comment "three different individuals"@en) ex:morphine ex:ibuprofen ex:alice)
 ClassAssertion(ex:Adult ex:alice)
 ClassAssertion(Annotation(rdfs:comment "an order of an opioid"@en) ObjectSomeValuesFrom(ex:prescribes ex:Opioid) _:order1)
 ObjectPropertyAssertion(ex:prescribes _:order1 ex:morphine)
 NegativeObjectPropertyAssertion(Annotation(rdfs:comment "not prescribed by"@en) ObjectInverseOf(ex:prescribedBy) ex:alice ex:drSmith)
 DataPropertyAssertion(ex:ageYears ex:alice "34"^^xsd:integer)
 NegativeDataPropertyAssertion(Annotation(rdfs:comment "no weight"@en) ex:weightKg ex:alice "12"@en)
 AnnotationAssertion(Annotation(rdfs:comment "the label of morphine"@en) rdfs:label ex:morphine "morphine"@en)
 AnnotationAssertion(ex:source _:order1 ex:ward3)
 SubAnnotationPropertyOf(ex:source rdfs:seeAlso)
 AnnotationPropertyDomain(ex:source ex:Order)
 AnnotationPropertyRange(ex:source xsd:anyURI)
)
