Prefix(ex:=<https://example.org/maintenance/>)
Ontology(ex:plant
 Annotation(rdfs:label "Maintenance with part hierarchies")
 Declaration(Class(ex:Machine))
 Declaration(Class(ex:Pump))
 Declaration(Class(ex:FaultyPart))
 Declaration(Class(ex:NeedsInspection))
 Declaration(ObjectProperty(ex:hasPart))
 Declaration(ObjectProperty(ex:hasComponent))
 Declaration(NamedIndividual(ex:pump1))
 Declaration(NamedIndividual(ex:motor1))
 Declaration(NamedIndividual(ex:bearing1))
 TransitiveObjectProperty(Annotation(rdfs:comment "A part of a part is a part") ex:hasPart)
 SubObjectPropertyOf(ex:hasComponent ex:hasPart)
 SubClassOf(ex:Pump ex:Machine)
 SubClassOf(ObjectIntersectionOf(ex:Machine ObjectSomeValuesFrom(ex:hasPart ex:FaultyPart)) ex:NeedsInspection)
 ClassAssertion(ex:Pump ex:pump1)
 ObjectPropertyAssertion(ex:hasComponent ex:pump1 ex:motor1)
 ObjectPropertyAssertion(ex:hasComponent ex:motor1 ex:bearing1)
 ClassAssertion(ex:FaultyPart ex:bearing1)
)
