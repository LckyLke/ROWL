Prefix(ex:=<https://example.org/maintenance/>)
Ontology(ex:fleet
 Annotation(rdfs:label "Maintenance individuals")
 Declaration(Class(ex:Machine))
 Declaration(Class(ex:Pump))
 Declaration(Class(ex:FaultyPart))
 Declaration(Class(ex:NeedsInspection))
 Declaration(ObjectProperty(ex:hasPart))
 Declaration(NamedIndividual(ex:pump1))
 Declaration(NamedIndividual(ex:pump2))
 Declaration(NamedIndividual(ex:motor1))
 SubClassOf(ex:Pump ex:Machine)
 SubClassOf(Annotation(rdfs:comment "Machines with a faulty part need inspection") ObjectIntersectionOf(ex:Machine ObjectSomeValuesFrom(ex:hasPart ex:FaultyPart)) ex:NeedsInspection)
 ClassAssertion(ex:Pump ex:pump1)
 ClassAssertion(ex:Pump ex:pump2)
 ObjectPropertyAssertion(ex:hasPart ex:pump1 ex:motor1)
 ClassAssertion(ex:FaultyPart ex:motor1)
 ObjectPropertyAssertion(ex:hasPart ex:pump2 _:seal)
 NegativeObjectPropertyAssertion(ex:hasPart ex:pump2 ex:motor1)
)
