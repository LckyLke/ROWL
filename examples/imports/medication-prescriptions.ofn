Prefix(:=<https://example.org/medication/>)
Ontology(<https://example.org/medication/prescriptions>
 Import(<https://example.org/medication/vocabulary/1.0>)
 Annotation(rdfs:comment "Prescriptions and allergies; the drug vocabulary and the alert rule are imported.")
 Declaration(NamedIndividual(:alice))
 Declaration(NamedIndividual(:bob))
 Declaration(NamedIndividual(:carol))
 Declaration(NamedIndividual(:comboPack))
 Declaration(NamedIndividual(:capsule))
 Declaration(NamedIndividual(:tablet))
 ClassAssertion(ObjectSomeValuesFrom(:hasAllergy :PenicillinAllergy) :alice)
 ObjectPropertyAssertion(:receives :alice :comboPack)
 ObjectPropertyAssertion(:receives :bob :comboPack)
 ObjectPropertyAssertion(:contains :comboPack :capsule)
 ClassAssertion(ObjectSomeValuesFrom(:hasActiveIngredient :Amoxicillin) :capsule)
 ClassAssertion(ObjectSomeValuesFrom(:hasAllergy :PenicillinAllergy) :carol)
 ObjectPropertyAssertion(:receives :carol :tablet)
 ClassAssertion(ObjectSomeValuesFrom(:hasActiveIngredient :Azithromycin) :tablet)
)
