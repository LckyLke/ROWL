Prefix(ex:=<https://example.org/medication/>)
Ontology(ex:records
 Annotation(rdfs:label "Medication safety")
 Annotation(rdfs:comment "An illustration of allergy checking, not clinical guidance.")
 Declaration(Class(ex:Penicillin))
 Declaration(Class(ex:Amoxicillin))
 Declaration(Class(ex:PenicillinAllergy))
 Declaration(Class(ex:AllergyAlert))
 Declaration(ObjectProperty(ex:contains))
 Declaration(ObjectProperty(ex:hasActiveIngredient))
 Declaration(ObjectProperty(ex:receives))
 Declaration(ObjectProperty(ex:hasAllergy))
 Declaration(NamedIndividual(ex:alice))
 Declaration(NamedIndividual(ex:bob))
 Declaration(NamedIndividual(ex:comboPack))
 Declaration(NamedIndividual(ex:capsule))
 TransitiveObjectProperty(Annotation(rdfs:comment "Whatever a part contains, the whole contains") ex:contains)
 SubObjectPropertyOf(ex:hasActiveIngredient ex:contains)
 SubClassOf(ex:Amoxicillin ex:Penicillin)
 SubClassOf(Annotation(rdfs:comment "A penicillin allergy and a medication containing a penicillin need an alert") ObjectIntersectionOf(ObjectSomeValuesFrom(ex:hasAllergy ex:PenicillinAllergy) ObjectSomeValuesFrom(ex:receives ObjectSomeValuesFrom(ex:contains ex:Penicillin))) ex:AllergyAlert)
 ClassAssertion(ObjectSomeValuesFrom(ex:hasAllergy ex:PenicillinAllergy) ex:alice)
 ObjectPropertyAssertion(ex:receives ex:alice ex:comboPack)
 ObjectPropertyAssertion(ex:receives ex:bob ex:comboPack)
 ObjectPropertyAssertion(ex:contains ex:comboPack ex:capsule)
 ClassAssertion(ObjectSomeValuesFrom(ex:hasActiveIngredient ex:Amoxicillin) ex:capsule)
)
